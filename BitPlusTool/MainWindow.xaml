<Window x:Class="BitPlusTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BitPlusTool"
        mc:Ignorable="d"
        Title="BIT PLUS Tool" Height="860" Width="1360" MinHeight="640" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBackgroundBrush}" FontFamily="Segoe UI"
        Icon="Resources/AppIcon.ico">
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,14,0">
                <Button x:Name="ZoomOutButton" Content="A-" Style="{StaticResource ZoomButton}" Click="ZoomButton_Click" ToolTip="Schrift verkleinern"/>
                <Button x:Name="ZoomInButton" Content="A+" Style="{StaticResource ZoomButton}" Click="ZoomButton_Click" ToolTip="Schrift vergroessern" Margin="6,0,0,0"/>
                <Button x:Name="HelpButton" Content="?" Style="{StaticResource ZoomButton}" Click="HelpButton_Click" ToolTip="Anleitung oeffnen" Margin="6,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="BIT PLUS Tool" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Border Background="{DynamicResource WarnBackgroundBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,8,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarnTextBrush}" FontSize="14">
                        <Run FontWeight="Bold" Text="Hinweis: "/>
                        <Run Text="Die interne PLUS-Vorlage ist fest eingebettet, keine Auswahl noetig. TME eingeben, Dateiname wird automatisch daraus gebildet. Im Tab 'Selbstkontrolle' pruefen mehrere automatische Checks, ob dein Ausdruck korrekt gelesen und uebersetzt wurde."/>
                    </TextBlock>
                </Border>
            </StackPanel>
            <Button x:Name="ThemeToggleButton" Grid.Column="2" Style="{StaticResource ThemeToggleButton}"
                    VerticalAlignment="Top" Click="ThemeToggleButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="14" Height="14" Margin="0,0,7,0">
                        <Ellipse x:Name="SunIcon" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"/>
                        <Path x:Name="SunRays" Data="M7,0 L7,2 M7,12 L7,14 M0,7 L2,7 M12,7 L14,7"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="MoonIcon" Visibility="Collapsed"
                              Data="M7,1 A6,6 0 1,1 7,13 A6,6 0 1,1 7,1 Z M9.5,1 A5,5 0 1,1 9.5,11 A5,5 0 1,1 9.5,1 Z"
                              Fill="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <TextBlock x:Name="ThemeToggleText" Text="Dunkel" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Technisches Merkmal (TME)" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBox x:Name="TmBox" ToolTip="z. B. TH1144" TextChanged="TmBox_TextChanged"/>
                    <TextBlock Text="Baureihe" Style="{StaticResource SectionLabelStyle}" Margin="0,10,0,4"/>
                    <WrapPanel x:Name="BaureihePanel" ToolTip="Baureihe fuer Codeliste/Gueltigkeitspruefung, optional">
                        <RadioButton Content="Keine" GroupName="Baureihe" Style="{StaticResource BaureiheChip}" IsChecked="True" Checked="BaureiheChip_Checked"/>
                        <RadioButton Content="192" GroupName="Baureihe" Style="{StaticResource BaureiheChip}" Checked="BaureiheChip_Checked"/>
                        <RadioButton Content="206" GroupName="Baureihe" Style="{StaticResource BaureiheChip}" Checked="BaureiheChip_Checked"/>
                        <RadioButton Content="232" GroupName="Baureihe" Style="{StaticResource BaureiheChip}" Checked="BaureiheChip_Checked"/>
                        <RadioButton Content="236" GroupName="Baureihe" Style="{StaticResource BaureiheChip}" Checked="BaureiheChip_Checked"/>
                        <RadioButton Content="254" GroupName="Baureihe" Style="{StaticResource BaureiheChip}" Checked="BaureiheChip_Checked"/>
                        <RadioButton Content="295" GroupName="Baureihe" Style="{StaticResource BaureiheChip}" Checked="BaureiheChip_Checked"/>
                        <RadioButton Content="540" GroupName="Baureihe" Style="{StaticResource BaureiheChip}" Checked="BaureiheChip_Checked"/>
                    </WrapPanel>
                    <TextBlock Text="Dateiname XML" Style="{StaticResource SectionLabelStyle}" Margin="0,10,0,4"/>
                    <TextBox x:Name="FileNameBox" ToolTip="wird aus TME erzeugt, z. B. TH1144.xml" TextChanged="FileNameBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Codebedingung" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBox x:Name="CodeBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="(M256+M30+M016+M005-M010)/(M139+M20+M014+M005+ME10)/(M177+M40+M014+M005+M010);"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Click="RunButton_Click" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,1 L2,15 L14,8 Z" Fill="{DynamicResource TextOnAccentBrush}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,9,0"/>
                            <TextBlock Text="Auswerten" Foreground="{DynamicResource TextOnAccentBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource SecondaryButton}" Click="SaveButton_Click" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8,1.5 L8,10.5 M3.5,7 L8,11.5 L12.5,7 M2,14.5 L14,14.5" Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="13" Height="13" Margin="0,0,9,0"/>
                            <TextBlock Text="XML speichern" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportButton" Style="{StaticResource SecondaryButton}" Click="ImportButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8,10.5 L8,1.5 M3.5,5 L8,0.5 L12.5,5 M2,14.5 L14,14.5" Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="13" Height="13" Margin="0,0,9,0"/>
                            <TextBlock Text="XML importieren" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Interne Vorlage: eingebettet" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,12">
            <TextBlock x:Name="StatusText" Text="Bereit." FontSize="15" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="4">
            <TabControl x:Name="MainTabs" BorderThickness="0" Background="Transparent" Margin="4">
                <TabItem Header="PLUS-Ansicht">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="Wichtig: Zeilen sind UND-verknuepft. Mehrere Werte in derselben Zeile sind ODER-verknuepft. Die Nr.-Bloecke stehen nebeneinander - bei Bedarf horizontal scrollen." Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="4,0,4,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PlusGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PlusBlockCardStyle}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Style="{StaticResource PlusBlockHeaderStyle}">
                                                    <TextBlock Text="{Binding Lfd, StringFormat='Nr. {0}'}" FontWeight="Bold"
                                                               Foreground="{DynamicResource GroupHeaderFgBrush}" FontSize="16"/>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,7">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="24"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Zeile}" Foreground="{DynamicResource TextMutedBrush}"
                                                                           FontFamily="Consolas" FontSize="13"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Definition}" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Typ}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Normalisierte Logik">
                    <TextBox x:Name="LogicBox" Margin="8" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </TabItem>

                <TabItem Header="XML-Vorschau">
                    <TextBox x:Name="XmlBox" Margin="8" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </TabItem>

                <TabItem Header="Selbstkontrolle">
                    <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChecksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="6,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontWeight="Bold" FontSize="16" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{Binding Brush}"/>
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextCheckDetailBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="TME-Referenzen">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="Wenn die Codebedingung ein anderes Technisches Merkmal referenziert (z. B. TME PH6068), kannst du hier dessen eigene Export-XML importieren, um seine Definition zu sehen." Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="4,0,4,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TmeRefList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="6,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding Code}"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap"/>
                                                    <TextBox Text="{Binding Codebedingung, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                                             TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding CodeVisibility}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Importieren..." Style="{StaticResource SecondaryButton}"
                                                        VerticalAlignment="Top" Click="ImportTmeRef_Click" CommandParameter="{Binding Code}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
    </Grid>
</Window>

