<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BitPlusTool</AssemblyName>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Vorab in nativen Code uebersetzt statt bei jedem Start per JIT -> spuerbar schnellerer Kaltstart. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <Version Condition="'$(Version)'==''">1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\template.xml" />
    <EmbeddedResource Include="Resources\codedata.csv" />
    <EmbeddedResource Include="Resources\motordata.csv" />
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\Screenshots\plusansicht.png" />
    <Resource Include="Resources\Screenshots\selbstkontrolle.png" />
    <Resource Include="Resources\Screenshots\normalisiertelogik.png" />
  </ItemGroup>

  <!-- Stand der eingebetteten Stammdaten (Datum der zuletzt aktualisierten Quelldatei) fuer die Anzeige im UI. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CodelisteStand</_Parameter1>
      <_Parameter2>$([System.IO.File]::GetLastWriteTime('$(MSBuildProjectDirectory)\Resources\codedata.csv').ToString("dd.MM.yyyy"))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BaumusterStand</_Parameter1>
      <_Parameter2>$([System.IO.File]::GetLastWriteTime('$(MSBuildProjectDirectory)\Resources\motordata.csv').ToString("dd.MM.yyyy"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
